PORT=3000

# From your Supabase project: Project Settings -> Database -> Connection
# string -> URI tab. Use the "Transaction pooler" connection string (port
# 6543) for most hosts; use the direct connection (port 5432) if your host
# supports long-lived connections and you prefer that.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres
